PORT=5000
NODE_ENV=development

# JWT Secrets (Fallback & Session)
JWT_SECRET=your_vendor_jwt_secret_key_2026
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_2026
ADMIN_JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# Firebase Configuration (Production Firestore, Auth, Storage, FCM)
# Option 1: Path to Firebase Admin service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Inline Environment Variables
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Local Emulator (Optional for testing)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
