# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/leader.db

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key-min-64-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_TIMEOUT_MINUTES=480

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=dev
