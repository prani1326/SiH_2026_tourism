# ==============================================================================
# Tourist & Traveler Enterprise Platform - Environment Configuration Template
# Architecture: Tourist App → FastAPI → Firebase Admin SDK → Firebase
# Firebase: Firestore (DB) + Auth + Storage + FCM Notifications
# ==============================================================================

# Environment: "development" | "staging" | "production" | "test"
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="International and Domestic Tourist Platform API"
DEBUG=false

# Security & JWT Token Lifecycle
# CAUTION: In production, generate a cryptographically strong 64-char random hex key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sih-tourist-secret-key-enterprise-2026-super-secure-token-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Primary Database: Cloud Firestore (Single Source of Truth)
FIRESTORE_PROJECT_ID=trip-planner-version-1
FIRESTORE_DATABASE_ID=(default)
# Optional: Set for local Firestore Emulator testing (e.g. localhost:8080)
FIRESTORE_EMULATOR_HOST=

# Firebase Admin SDK (Auth, Firestore, Cloud Storage & FCM Push Notifications)
# In production, provide the absolute path to your downloaded Service Account JSON:
# e.g., FIREBASE_CREDENTIALS_PATH=/etc/secrets/serviceAccountKey.json
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=trip-planner-version-1
FIREBASE_STORAGE_BUCKET=trip-planner-version-1.firebasestorage.app
FIREBASE_MOCK_MODE=false

# Redis (Sliding-window Rate Limiting, Token Revocation, OTP Cache, Task Queue)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# Payment Gateway: Razorpay (India UPI, Cards, Netbanking & International Forex)
# Mandatory in production mode:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# Google Maps Platform (Geocoding, Places, Distance Matrix travel times)
GOOGLE_MAPS_API_KEY=

# Weather Data Provider (OpenWeatherMap API)
OPENWEATHER_API_KEY=

# Generative AI Trip Planning Engine (Google Gemini API)
# Supports GEMINI_API_KEY or GOOGLE_API_KEY:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transactional Communications (Email via SMTP & SMS via Twilio)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@touristplatform.gov.in

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=120
IDEMPOTENCY_EXPIRY_SECONDS=86400

# CORS Allowed Origins (Comma-separated in production, wildcard strictly prohibited in prod)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
