rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isPrivilegedRole() {
      return isAuthenticated() && (
        request.auth.token.role in ['admin', 'ops_leader', 'vendor', 'support']
      );
    }

    // User Profiles & Safety Subcollections:
    // Users can read and update only their own profile and safety data.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;

      // Emergency and Safety Contacts
      match /emergencyContacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
      match /safetyContacts/{contactId} {
        allow read, write: if isOwner(userId);
      }

      // Safety Settings
      match /safetySettings/{settingDoc} {
        allow read, write: if isOwner(userId);
      }
      match /safety/{settingDoc} {
        allow read, write: if isOwner(userId);
      }

      // Device Status & Health Telemetry
      match /deviceStatus/{statusDoc} {
        allow read: if isOwner(userId) || isPrivilegedRole();
        allow write: if isOwner(userId);
      }

      // Safety Events
      match /safetyEvents/{eventId} {
        allow read: if isOwner(userId) || isPrivilegedRole();
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isPrivilegedRole();
        allow delete: if false;
      }

      // Safety Audit Logs
      match /safetyAuditLogs/{logId} {
        allow read: if isOwner(userId) || isPrivilegedRole();
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // AI Conversations & Messages
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId);
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Destinations:
    // Anyone (authenticated or guest) can read destination info.
    // Writes are restricted to backend / admin roles.
    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Trips:
    // Users can only read, create, update, and delete their own trips.
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.user_id == request.auth.uid || isPrivilegedRole());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.user_id == request.auth.uid || request.auth.token.role == 'admin');
    }

    // Bookings:
    // Strict isolation - users can only view and manage their own bookings.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.user_id == request.auth.uid || isPrivilegedRole());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isPrivilegedRole());
      allow delete: if false;
    }

    // SOS Alerts:
    // Authenticated users can create alerts; only the owner or operations leader/assigned vendor can view them.
    match /sos_alerts/{alertId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        resource.data.user_id == request.auth.uid ||
        isPrivilegedRole()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.user_id == request.auth.uid ||
        isPrivilegedRole()
      );
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Incidents:
    match /incidents/{incidentId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isPrivilegedRole()
      );
      allow update: if isAuthenticated() && isPrivilegedRole();
      allow delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
